# Copy this file to `.env` (git-ignored) and set local development values.
# These are local-only placeholders; do not commit real credentials.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=
POSTGRES_DB=eventflow
POSTGRES_PORT=5432

# --- Work Management service (ADR-008) ---
# Dialect must be postgresql+psycopg (psycopg 3).
EVENTFLOW_DATABASE_URL=postgresql+psycopg://eventflow:CHANGE_ME@localhost:5432/eventflow
# Admin database used by integration tests to create throwaway databases.
EVENTFLOW_TEST_DATABASE_URL=postgresql+psycopg://eventflow:CHANGE_ME@localhost:5432/postgres
