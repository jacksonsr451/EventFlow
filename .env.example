# Copy this file to `.env` (git-ignored) and set local development values.
# These are local-only placeholders; do not commit real credentials. The
# authentication bootstrap also uses this secret-free model to create
# `.local-data/authentication-test.env`, generating blank passwords and keys.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=
POSTGRES_DB=eventflow
POSTGRES_PORT=5432

# --- Work Management service (ADR-008) ---
# Dialect must be postgresql+psycopg (psycopg 3).
EVENTFLOW_DATABASE_URL=postgresql+psycopg://eventflow:CHANGE_ME@localhost:5432/eventflow
# Admin database used by integration tests to create throwaway databases.
EVENTFLOW_TEST_DATABASE_URL=postgresql+psycopg://eventflow:CHANGE_ME@localhost:5432/postgres

# --- Authentication development configuration (Keycloak / Issue #10) ---
KEYCLOAK_ADMIN_USERNAME=eventflow-admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8082
KEYCLOAK_REALM_IMPORT_FILE=./infra/keycloak/realm-eventflow-test.json
EVENTFLOW_AUTH_COMPOSE_PROJECT=eventflow-auth-dev
EVENTFLOW_ENVIRONMENT=test
EVENTFLOW_OIDC_ISSUER=http://localhost:8082/realms/eventflow
EVENTFLOW_OIDC_WEB_CLIENT_ID=eventflow-web-bff
EVENTFLOW_OIDC_NATIVE_CLIENT_IDS=eventflow-desktop,eventflow-vscode
EVENTFLOW_OIDC_API_AUDIENCE=eventflow-api
EVENTFLOW_OIDC_REDIRECT_URI=http://localhost:8000/v1/auth/oidc/callback
EVENTFLOW_WEB_REDIRECT_AFTER_LOGIN=https://localhost/auth/complete
EVENTFLOW_CORS_ALLOWED_ORIGINS=https://localhost,http://localhost:5173
EVENTFLOW_TOKEN_ENCRYPTION_KEYS=
EVENTFLOW_AUTH_INTEGRATION=1
EVENTFLOW_TEST_KEYCLOAK_USERNAME=
EVENTFLOW_TEST_KEYCLOAK_PASSWORD=
